# cmd/server
ADDR=:8080
APP_ENV=local
DATABASE_URL=postgres://fieldsync:fieldsync@localhost:5432/fieldsync?sslmode=disable

# S3-compatible storage for photo uploads (MinIO, not LocalStack — see
# docker-compose.yml comment: LocalStack now requires a paid/free-signup auth
# token just to boot, even for S3, discovered while building Phase 3)
S3_ENDPOINT=http://localhost:9000
S3_PHOTOS_BUCKET=fieldsync-photos
S3_ACCESS_KEY=localdevuser
S3_SECRET_KEY=localdevpassword
AWS_REGION=us-east-1

# Local AWS emulators (docker-compose) — unused by code until the phase noted
COGNITO_LOCAL_ENDPOINT=http://localhost:9229     # Phase 1
MOTO_ENDPOINT=http://localhost:5001              # Phase 7 (EventBridge) — host port remapped, see docker-compose.yml
